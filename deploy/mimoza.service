[Unit]
Description=Mimoza Floral Django application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mimoza
EnvironmentFile=/etc/mimoza/mimoza.env
ExecStart=/opt/mimoza/.venv/bin/gunicorn core.wsgi:application --bind 127.0.0.1:8000 --workers 3 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
