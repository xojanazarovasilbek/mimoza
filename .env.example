# Copy these settings into the server's protected environment file.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

R2_STORAGE_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=

# Absolute path to a protected Firebase service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# Keep payment credentials in the protected server environment, never in the app.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

PAYME_MERCHANT_ID=
PAYME_MERCHANT_LOGIN=
PAYME_MERCHANT_KEY=
PAYME_ACCOUNT_FIELD=order_id

# Uzum remains disabled until its callback verification method is confirmed.
UZUM_TERMINAL_ID=
UZUM_API_KEY=

FFMPEG_BINARY=ffmpeg

# Optional SMTP relay; production defaults to a local MTA on port 25.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
